# 이 파일을 같은 폴더의 .env로 복사한 뒤 필요할 때만 수정하세요.
# 기본값은 팀 AI 서버에 연결하지 않는 통신 시험 모드입니다.
# .env, API 키, 인증서 개인키는 팀 배포 ZIP이나 Git에 넣지 마세요.

# 팀 AI 서버가 준비되면 전체 HTTP POST 주소를 입력합니다.
# 예: http://127.0.0.1:9000/analyze
SENSE_AI_URL=

# 팀 AI 서버가 키를 요구할 때만 입력합니다. 브라우저로 보내지 않습니다.
SENSE_AI_KEY=

# PC의 Ollama 모델을 쓰려면 SENSE_AI_URL을 비우고 로컬 모델 이름을 입력하세요.
# 예: qwen3-vl:4b-instruct
SENSE_OLLAMA_MODEL=

# 선택. CTranslate2로 변환한 다국어 Whisper 모델의 로컬 폴더입니다.
SENSE_STT_MODEL_PATH=

# 선택. Windows에 설치된 SAPI 음성 이름입니다. 예: Microsoft Heami Desktop
SENSE_TTS_VOICE=

# 필요 시 WebRTC 담당자가 합의한 ICE 서버 목록(JSON 배열)을 넣습니다.
# 기본 빈 배열은 같은 로컬 네트워크 시험을 위한 설정입니다.
SENSE_ICE_SERVERS=[]

# 로컬 모델의 첫 실행이 느리면 55초 등으로 늘릴 수 있습니다.
SENSE_AI_TIMEOUT=15
SENSE_GUIDE_INTERVAL=2
SENSE_FRAME_MAX_AGE=2
SENSE_SESSION_TTL=900
SENSE_MAX_SESSIONS=8
SENSE_AUDIO_TAIL_MS=300
